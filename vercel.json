{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "landing_red": {
      "root": "apps/landing-red/",
      "framework": "vite"
    },
    "management_web": {
      "root": "apps/web/",
      "framework": "vite"
    },
    "institutional_landing": {
      "root": "apps/landing-shippiyyukon/",
      "framework": "vite"
    },
    "api_backend": {
      "root": "services/api/"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "has": [
        {
          "type": "host",
          "value": "redpanel.shippiyyukon.org"
        }
      ],
      "destination": {
        "service": "api_backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api_backend"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "red.shippiyyukon.org"
        }
      ],
      "destination": {
        "service": "landing_red"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "redpanel.shippiyyukon.org"
        }
      ],
      "destination": {
        "service": "management_web"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "shippiyyukon.org"
        }
      ],
      "destination": {
        "service": "institutional_landing"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "institutional_landing"
      }
    }
  ]
}
