{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "landing_red": {
      "root": "apps/landing-red/",
      "framework": "vite"
    },
    "management_web": {
      "root": "apps/web/",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api_backend": {
      "root": "services/api/",
      "entrypoint": "api/index.ts"
    },
    "institutional_landing": {
      "root": "apps/landing-shippiyyukon/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api_backend",
        "path": "/api"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "pre": "shippyyukon-portal-git-feat-phase1a-auth-foundation-",
            "suf": ".vercel.app"
          }
        }
      ],
      "destination": {
        "service": "management_web"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "red.shippiyyukon.org"
        }
      ],
      "destination": {
        "service": "landing_red"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "redpanel.shippiyyukon.org"
        }
      ],
      "destination": {
        "service": "management_web"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "shippiyyukon.org"
        }
      ],
      "destination": {
        "service": "institutional_landing"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "institutional_landing"
      }
    }
  ]
}
